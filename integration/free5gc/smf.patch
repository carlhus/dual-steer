index 0000000..b70caf0
--- /dev/null
+++ b/internal/dualsteer/runtime.go
@@ -0,0 +1,89 @@
+// Package dualsteer provides the opt-in, non-3GPP research control interface.
+package dualsteer
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"time"
+)
+
+const prefix = "/research/dualsteer/v1"
+
+func decode(r io.Reader, target any) error {
+	decoder := json.NewDecoder(io.LimitReader(r, 65537))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		return err
+	}
+	var extra any
+	if err := decoder.Decode(&extra); !errors.Is(err, io.EOF) {
+		return fmt.Errorf("expected one JSON object")
+	}
+	return nil
+}
+
+func readConfig(path string, target any) error {
+	if path == "" {
+		return fmt.Errorf("--dualsteer-config is required in research mode")
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	return decode(file, target)
+}
+
+func reply(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(value)
+}
+
+func fail(w http.ResponseWriter, status int, err error) {
+	reply(w, status, map[string]string{"error": err.Error()})
+}
+
+func serve(ctx context.Context, address string, handler http.Handler) error {
+	host, _, err := net.SplitHostPort(address)
+	if err != nil {
+		return err
+	}
+	ip := net.ParseIP(host)
+	if ip == nil || !ip.IsLoopback() {
+		return fmt.Errorf("research listen address must use a loopback IP")
+	}
+	listener, err := net.Listen("tcp", address)
+	if err != nil {
+		return err
+	}
+	server := &http.Server{Handler: handler, ReadHeaderTimeout: 3 * time.Second, ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second, IdleTimeout: 30 * time.Second}
+	done := make(chan struct{})
+	stopped := make(chan struct{})
+	go func() {
+		defer close(stopped)
+		select {
+		case <-ctx.Done():
+			shutdown, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			if err := server.Shutdown(shutdown); err != nil {
+				_ = server.Close()
+			}
+		case <-done:
+		}
+	}()
+	fmt.Fprintf(os.Stderr, "DualSteer research API listening on %s; normal NF registration and session procedures are disabled\n", listener.Addr())
+	err = server.Serve(listener)
+	close(done)
+	<-stopped
+	if errors.Is(err, http.ErrServerClosed) {
+		return nil
+	}
+	return err
+}
